# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://fmctrichy.com

# WhatsApp number that receives leads (digits only, with country code)
# TODO: confirm with client before launch. Current site links to 917448939808.
NEXT_PUBLIC_WHATSAPP_NUMBER=917448939808

# WhatsApp number for international patients (digits only, with country code).
# TODO: confirm with client. Falls back to NEXT_PUBLIC_WHATSAPP_NUMBER if unset.
NEXT_PUBLIC_WHATSAPP_INTL_NUMBER=

# GA4 measurement ID, optional. Analytics is off when unset.
NEXT_PUBLIC_GA4_ID=

# Resend API key for form email delivery.
# Forms return a friendly call/WhatsApp fallback error when unset in production.
RESEND_API_KEY=

# Lead inbox
LEADS_EMAIL_TO=fmc.trichy@gmail.com
LEADS_EMAIL_FROM=appointments@yourdomain.com

# Indexing: search engines are allowed only on the production build
# (Vercel sets VERCEL_ENV=production automatically). To allow indexing on a
# non-Vercel production host, set INDEXABLE=1.
INDEXABLE=
